

#include <Arduino.h>
#include <freertos/FreeRTOS.h>
#include <freertos/task.h>
#include <freertos/semphr.h>

// — PARAMETERS (in milliseconds) —
static const uint32_t MIN_ARRIVAL = 5000;   // 5–10 s between arrivals
static const uint32_t MAX_ARRIVAL = 10000;
static const uint32_t GREEN_TIME   = 8000;  // 8 s green
static const uint32_t GAP_TIME     = 2000;  // 2 s all-red

// — QUEUE LENGTHS & LABELS —
static int q[4] = {0, 0, 0, 0};
static const char* phaseName[4] = {
  "NS Through/Right",
  "EW Through/Right",
  "NS Left",
  "EW Left"
};
static const char* arrNames[4] = {
  "Arrival0", "Arrival1", "Arrival2", "Arrival3"
};

// — MUTEX for protecting q[] increments/reads —
SemaphoreHandle_t qMutex;

// --------------------------------------------------
// Arrival Task: simulates one bundle’s random arrivals
// --------------------------------------------------
void arrivalTask(void* pvParameters) {
  int idx = (int)(intptr_t)pvParameters;
  for (;;) {
    // wait a random interval
    vTaskDelay(pdMS_TO_TICKS(random(MIN_ARRIVAL, MAX_ARRIVAL)));

    // safely increment queue length
    xSemaphoreTake(qMutex, portMAX_DELAY);
      q[idx]++;
      Serial.printf("[ARRIVAL] %s → q[%d] = %d\n",
                    phaseName[idx], idx, q[idx]);
    xSemaphoreGive(qMutex);
  }
}

// --------------------------------------------------
// Scheduler Task: picks the heaviest queue & serves it
// --------------------------------------------------
void schedulerTask(void*) {
  // give a head start for some arrivals
  vTaskDelay(pdMS_TO_TICKS(2000));

  for (;;) {
    // wait until at least one car is waiting
    int total;
    do {
      vTaskDelay(pdMS_TO_TICKS(500));
      xSemaphoreTake(qMutex, portMAX_DELAY);
        total = q[0] + q[1] + q[2] + q[3];
      xSemaphoreGive(qMutex);
    } while (total == 0);

    // compute & pick the heaviest queue
    xSemaphoreTake(qMutex, portMAX_DELAY);
      int best = 0;
      for (int i = 1; i < 4; ++i) {
        if (q[i] > q[best]) best = i;
      }
      int served = q[best];
      q[best] = 0;
    xSemaphoreGive(qMutex);

    // announce green start
    Serial.printf("\n>> GREEN START: %s\n"
                  "   Cars served: %d\n"
                  "   Queues now:  [%d, %d, %d, %d]\n",
                  phaseName[best], served,
                  q[0], q[1], q[2], q[3]);

    // hold green
    vTaskDelay(pdMS_TO_TICKS(GREEN_TIME));
    Serial.printf("<< GREEN END:   %s\n", phaseName[best]);

    // all-red gap
    Serial.println("** ALL-RED GAP **");
    vTaskDelay(pdMS_TO_TICKS(GAP_TIME));
  }
}

// --------------------------------------------------
// Arduino setup() & loop()
// --------------------------------------------------
void setup() {
  Serial.begin(115200);
  delay(200);
  Serial.println("\n--- 4-Queue Dynamic Max-Weight Scheduler ---");

  // create the mutex
  qMutex = xSemaphoreCreateMutex();

  // seed random from an analog pin
  randomSeed(analogRead(34));

  // launch four arrival tasks
  for (int i = 0; i < 4; ++i) {
    xTaskCreate(
      arrivalTask,            // function
      arrNames[i],            // task name (const char*)
      2048,                   // stack size
      (void*)(intptr_t)i,     // parameter = queue index
      1,                      // priority
      NULL                    // handle (unused)
    );
  }

  // launch the scheduler task
  xTaskCreate(
    schedulerTask,
    "Scheduler",
    4096,
    NULL,
    1,
    NULL
  );
}

void loop() {
  // nothing here: all work is in FreeRTOS tasks
}
